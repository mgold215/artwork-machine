# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Hugging Face (free image generation via FLUX.1-schnell) ─────────────────
# 1. Create a free account at huggingface.co
# 2. Go to Settings → Access Tokens → New token (read permission is enough)
# 3. Go to huggingface.co/black-forest-labs/FLUX.1-schnell and click "Agree to licence"
HF_TOKEN=hf_...

# ── Image generation model ──────────────────────────────────────────────────
# Options (all free on HF):
#   black-forest-labs/FLUX.1-schnell        (best quality, recommended)
#   stabilityai/stable-diffusion-xl-base-1.0  (fallback, no licence needed)
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# ── Output settings ─────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Canvas / visualizer quality ─────────────────────────────────────────────
# "draft" = fast preview  |  "production" = final render
RENDER_QUALITY=production

# ── Spotify Canvas settings ──────────────────────────────────────────────────
CANVAS_FPS=30
CANVAS_DURATION_SECONDS=8

# ── YouTube Visualizer settings ───────────────────────────────────────────────
VISUALIZER_FPS=60
VISUALIZER_WIDTH=1920
VISUALIZER_HEIGHT=1080

# ── YouTube Data API v3 — for auto-uploading visualizer videos ───────────────
# 1. Create a Google Cloud project at https://console.cloud.google.com
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth 2.0 credentials (Desktop app type)
# 4. Run: python3 -m artwork_machine.upload.youtube_auth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
