# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Replicate (Flux 1.1 Pro image generation) ────────────────────────────────
REPLICATE_API_TOKEN=r8_...

# ── Runway Gen-3 (Spotify Canvas animation) ──────────────────────────────────
RUNWAY_API_TOKEN=...

# ── Output settings ─────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Style profiles directory ─────────────────────────────────────────────────
PROFILES_DIR=./profiles

# ── Canvas / visualizer quality ─────────────────────────────────────────────
# "draft" = fast preview (skips Runway, uses Ken-Burns)
# "production" = full quality (Runway Gen-3 animation)
RENDER_QUALITY=production

# ── Spotify Canvas settings ──────────────────────────────────────────────────
CANVAS_FPS=30
CANVAS_DURATION_SECONDS=8

# ── YouTube Visualizer settings ───────────────────────────────────────────────
VISUALIZER_FPS=60
VISUALIZER_WIDTH=1920
VISUALIZER_HEIGHT=1080

# ── Web server ───────────────────────────────────────────────────────────────
PORT=7860
