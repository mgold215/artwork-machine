# ── Anthropic / Claude ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Replicate (image generation via SDXL / Flux) ────────────────────────────
REPLICATE_API_TOKEN=r8_...

# ── Image generation model ──────────────────────────────────────────────────
# Options:
#   black-forest-labs/flux-1.1-pro          (best quality, slower)
#   stability-ai/sdxl:latest                (fast, great for cassette art)
#   lucataco/realistic-vision-v5:latest     (photorealistic)
IMAGE_MODEL=black-forest-labs/flux-1.1-pro

# ── Output settings ─────────────────────────────────────────────────────────
OUTPUT_DIR=./output

# ── Canvas / visualizer quality ─────────────────────────────────────────────
# "draft" = fast preview  |  "production" = final render
RENDER_QUALITY=production

# ── Spotify Canvas settings ──────────────────────────────────────────────────
CANVAS_FPS=30
CANVAS_DURATION_SECONDS=8

# ── YouTube Visualizer settings ───────────────────────────────────────────────
VISUALIZER_FPS=60
VISUALIZER_WIDTH=1920
VISUALIZER_HEIGHT=1080
